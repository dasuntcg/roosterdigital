---
const steps = [
	{ number: 1, title: "Quick Chat", description: "Tell us what you need." },
	{ number: 2, title: "We Plan It", description: "We recommend the best solution for your budget." },
	{ number: 3, title: "We Build", description: "Fast, clean and professional delivery." },
	{ number: 4, title: "Ongoing Support", description: "Need updates later? We've got you." },
];
---

<section class="py-stack-lg px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto">
	<h2 class="font-headline text-[40px] leading-[1.2] tracking-[-0.02em] font-bold text-on-surface mb-stack-lg text-center">
		Simple Process. No Headaches.
	</h2>

	<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-gutter">
		{steps.map((step) => (
			<div class="flex flex-col text-center">
				<div class="w-16 h-16 bg-primary text-on-primary rounded-full flex items-center justify-center text-2xl font-bold font-headline mx-auto mb-stack-sm brutalist-shadow">
					{step.number}
				</div>
				<h3 class="font-headline text-2xl leading-[1.3] font-bold text-on-surface mb-base">
					{step.title}
				</h3>
				<p class="text-base leading-relaxed text-secondary">{step.description}</p>
			</div>
		))}
	</div>
</section>
