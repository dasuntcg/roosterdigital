---
const services = [
	{
		icon: "web",
		title: "Websites",
		description: "Professional websites that look great, work on mobile, and help bring in enquiries.",
		featured: true,
	},
	{
		icon: "brush",
		title: "Branding",
		description: "Logos, business cards, email signatures and brand assets that make your business look professional.",
	},
	{
		icon: "my_location",
		title: "SEO & Local Visibility",
		description: "Helping local customers actually find your business online.",
	},
	{
		icon: "support_agent",
		title: "Ongoing Support",
		description: "Need updates, help or changes? We're easy to reach and quick to respond.",
	},
	{
		icon: "share",
		title: "Social Media Content",
		description: "Practical content and assets to help your business stay active online.",
	},
];
---

<section id="services" class="py-20 md:py-28 bg-white">
	<div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop">
		<!-- Section header -->
		<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
			<div>
				<div class="flex items-center gap-3 mb-6">
					<div class="w-6 h-px bg-primary"></div>
					<span class="text-primary text-xs font-medium tracking-[0.15em] uppercase">What We Do</span>
				</div>
				<h2 class="font-headline text-4xl leading-[1.2] tracking-[-0.01em] font-semibold text-on-surface">
					Simple Digital Solutions That<br />Actually Help Your Business Grow
				</h2>
			</div>
			<a
				href="#contact"
				class="shrink-0 inline-flex items-center gap-1 text-primary text-sm font-medium hover:underline underline-offset-4 transition-all"
			>
				Get a free quote &rarr;
			</a>
		</div>

		<!-- Service cards grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<!-- Featured: Websites -->
			<div class="md:row-span-2 bg-white rounded border border-outline-variant brutalist-shadow-hover transition-all duration-300 flex flex-col overflow-hidden group">
				<div class="p-8 flex-1">
					<div class="w-10 h-10 rounded bg-primary/10 flex items-center justify-center mb-6">
						<span class="material-symbols-outlined text-primary" style="font-size:20px;">web</span>
					</div>
					<h3 class="font-headline text-2xl font-semibold text-on-surface mb-3">Websites</h3>
					<p class="text-base leading-[1.8] text-secondary font-normal">
						Professional websites that look great, work on mobile, and help bring in enquiries.
					</p>
				</div>
				<!-- Real image -->
				<div class="h-52 overflow-hidden">
					<img
						src="https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?auto=format&fit=crop&w=600&q=80"
						alt="Website design on screen"
						class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
						loading="lazy"
					/>
				</div>
			</div>

			<!-- Other services -->
			{services.filter(s => !s.featured).map((service) => (
				<div class="bg-white rounded border border-outline-variant p-8 brutalist-shadow-hover transition-all duration-300 group">
					<div class="w-10 h-10 rounded bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary transition-all duration-300">
						<span class="material-symbols-outlined text-primary group-hover:text-on-primary transition-colors duration-300" style="font-size:20px;">{service.icon}</span>
					</div>
					<h3 class="font-headline text-xl font-semibold text-on-surface mb-3">{service.title}</h3>
					<p class="text-base leading-[1.8] text-secondary font-normal">{service.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
