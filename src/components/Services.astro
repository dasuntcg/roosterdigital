---
const smallServices = [
	{
		icon: "brush",
		title: "Branding",
		description: "Logos, business cards, email signatures and brand assets that make your business look professional.",
		class: "md:col-span-2",
	},
	{
		icon: "my_location",
		title: "SEO & Local Visibility",
		description: "Helping local customers actually find your business online.",
	},
	{
		icon: "support_agent",
		title: "Ongoing Support",
		description: "Need updates, help or changes? We're easy to reach and quick to respond.",
	},
	{
		icon: "share",
		title: "Social Media Content",
		description: "Practical content and assets to help your business stay active online.",
		class: "md:col-span-2",
	},
];
---

<section id="services" class="py-stack-lg px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto">
	<h2 class="font-headline text-[40px] leading-[1.2] tracking-[-0.02em] font-bold text-on-surface mb-stack-lg text-center">
		Simple Digital Solutions That Actually Help Your Business Grow
	</h2>

	<div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-gutter">
		<!-- Websites (Featured) -->
		<div class="md:col-span-2 md:row-span-2 bg-surface p-stack-md rounded border border-outline-variant brutalist-shadow-hover transition-all duration-300 flex flex-col justify-between group">
			<div>
				<span class="material-symbols-outlined text-primary text-3xl mb-base">web</span>
				<h3 class="font-headline text-[40px] leading-[1.2] tracking-[-0.02em] font-bold text-on-surface mb-base">Websites</h3>
				<p class="text-base leading-relaxed text-secondary">
					Professional websites that look great, work on mobile, and help bring in enquiries.
				</p>
			</div>
			<div class="mt-stack-md h-48 bg-surface-container rounded border border-outline-variant overflow-hidden relative">
				<img
					src="https://lh3.googleusercontent.com/aida-public/AB6AXuDXYnVp9M0Vhlo1mJbPix4PK0v_lfugmPf1zfXZ2zN8TIl03po-5tcv3N0-dMlj7Cz-n_6U67sxMwGSvxd1RZi6twD4Pbw-Gj3L6y81OEPkHYyVsh8k-eGHooNrHmYxcm9N8uou4_NmLpU_9vM9hFAoVzpLJKxd9CgihC_6ldiNZtPr8O4fMPSvlBtQGxjTmohuryAaapenc9hiRlvmx61NIffWsVe_xedCouvhYPSVBpVQqte89XX85Ko_I7P6UyX5G5nwB2Y3mg"
					alt="Modern web design interface on a laptop"
					class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
					loading="lazy"
				/>
			</div>
		</div>

		{smallServices.map((service) => (
			<div class:list={[
				"bg-surface p-stack-md rounded border border-outline-variant brutalist-shadow-hover transition-all duration-300",
				service.class,
			]}>
				<span class="material-symbols-outlined text-primary text-3xl mb-base">{service.icon}</span>
				<h3 class="font-headline text-2xl leading-[1.3] font-bold text-on-surface mb-base">{service.title}</h3>
				<p class="text-base leading-relaxed text-secondary">{service.description}</p>
			</div>
		))}
	</div>
</section>
