---
const services = [
	{
		title: "Websites",
		description: "Professional websites that look great, work on mobile, and help bring in enquiries.",
		lottie: "/lottie/web.json",
		featured: true,
	},
	{
		title: "Branding",
		description: "Logos, business cards, email signatures and brand assets that make your business look professional.",
		lottie: "/lottie/branding.json",
		scale: "160%",
		offset: "-10%",
	},
	{
		title: "SEO & Local Visibility",
		description: "Helping local customers actually find your business online.",
		lottie: "/lottie/seo.json",
		scale: "160%",
		offset: "-10%",
	},
	{
		title: "Ongoing Support",
		description: "Need updates, help or changes? We're easy to reach and quick to respond.",
		lottie: "/lottie/support.json",
		scale: "160%",
		offset: "0",
	},
	{
		title: "Social Media Content",
		description: "Practical content and assets to help your business stay active online.",
		lottie: "/lottie/social-media.json",
		scale: "160%",
		offset: "0",
	},
];
---

<section id="services" class="py-20 md:py-28 bg-white">
	<div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop">
		<!-- Section header -->
		<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16" data-animate="fade-up">
			<div>
				<div class="flex items-center gap-3 mb-6">
					<div class="w-6 h-px bg-primary"></div>
					<span class="text-primary text-xs font-medium tracking-[0.15em] uppercase">What We Do</span>
				</div>
				<h2 class="font-headline text-4xl leading-[1.2] tracking-[-0.01em] font-semibold text-on-surface">
					Simple Digital Solutions That<br />Actually Help Your Business Grow
				</h2>
			</div>
			<a
				href="#contact"
				class="shrink-0 inline-flex items-center gap-1 text-primary text-sm font-medium hover:underline underline-offset-4 transition-all"
			>
				Get a free quote &rarr;
			</a>
		</div>

		<!-- Service cards grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<!-- Featured: Websites -->
			<div data-animate="fade-up" data-animate-delay="100" class="md:row-span-2 bg-tertiary-container rounded border border-tertiary-fixed-dim brutalist-shadow-hover transition-all duration-300 flex flex-col overflow-hidden group">
				<div class="p-8">
					<h3 class="font-headline text-2xl font-semibold text-on-tertiary-container mb-3">Websites</h3>
					<p class="text-base leading-[1.8] text-on-tertiary-container/80 font-normal">
						Professional websites that look great, work on mobile, and help bring in enquiries.
					</p>
				</div>
				<div class="flex-1 flex items-center justify-center overflow-hidden">
					<div data-lottie="/lottie/web.json" class="w-[140%] aspect-square"></div>
				</div>
			</div>

			<!-- Other services -->
			{services.filter(s => !s.featured).map((service, i) => (
				<div data-animate="fade-up" data-animate-delay={`${(i + 1) * 100 + 100}`} class="bg-white rounded border border-outline-variant brutalist-shadow-hover transition-all duration-300 group flex flex-col overflow-hidden">
					<div class="w-full h-44 bg-surface-container-low flex items-center justify-center overflow-hidden">
						<div data-lottie={service.lottie} style={`width:${service.scale};height:${service.scale};margin-top:${service.offset}`}></div>
					</div>
					<div class="p-6">
						<h3 class="font-headline text-xl font-semibold text-on-surface mb-2">{service.title}</h3>
						<p class="text-sm leading-[1.7] text-secondary font-normal">{service.description}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	import lottie from "lottie-web";

	const containers = document.querySelectorAll<HTMLElement>("[data-lottie]");
	const animations: { anim: any; el: HTMLElement }[] = [];

	containers.forEach((el) => {
		const path = el.dataset.lottie;
		if (!path) return;

		const anim = lottie.loadAnimation({
			container: el,
			renderer: "svg",
			loop: true,
			autoplay: false,
			path,
		});

		animations.push({ anim, el });
	});

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				const match = animations.find((a) => a.el === entry.target);
				if (!match) return;

				if (entry.isIntersecting) {
					match.anim.play();
				} else {
					match.anim.pause();
				}
			});
		},
		{ threshold: 0.1 }
	);

	animations.forEach(({ el }) => observer.observe(el));
</script>
