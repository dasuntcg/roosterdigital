---
const serviceLinks = [
	{ label: "Custom Web Design", href: "#" },
	{ label: "SEO for Tradies", href: "#" },
	{ label: "Logo Branding", href: "#" },
];

const companyLinks = [
	{ label: "Maintenance", href: "#" },
	{ label: "Terms & Conditions", href: "#" },
];

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-surface-container-highest border-t-2 border-on-surface">
	<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter px-margin-mobile md:px-margin-desktop py-stack-lg w-full max-w-7xl mx-auto">
		<div class="flex flex-col gap-base">
			<span class="font-headline text-2xl font-bold text-on-surface">TRADIECORE</span>
			<p class="text-base text-primary">
				&copy; {currentYear} TRADIECORE WEB DESIGN. BUILT FOR THE BOLD.
			</p>
		</div>

		<div class="flex flex-col gap-base">
			{serviceLinks.map((link) => (
				<a
					href={link.href}
					class="text-xs font-medium text-secondary hover:text-on-surface hover:underline underline-offset-8 transition-all duration-300"
				>
					{link.label}
				</a>
			))}
		</div>

		<div class="flex flex-col gap-base">
			{companyLinks.map((link) => (
				<a
					href={link.href}
					class="text-xs font-medium text-secondary hover:text-on-surface hover:underline underline-offset-8 transition-all duration-300"
				>
					{link.label}
				</a>
			))}
		</div>
	</div>
</footer>
